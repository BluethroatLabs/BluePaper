FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

COPY requirements-api.txt /app/requirements-api.txt
RUN pip install --no-cache-dir -r /app/requirements-api.txt

COPY bluepaper /app/bluepaper
COPY share/ocr-languages.json /app/share/ocr-languages.json

# Identifies this image in GET /v1/source. Empty when the build did not pass it.
ARG SOURCE_COMMIT=""
ENV BLUEPAPER_SOURCE_COMMIT=${SOURCE_COMMIT}

RUN useradd --create-home --uid 10001 bluepaper
USER bluepaper

EXPOSE 8080
CMD ["python", "-m", "bluepaper.api"]
